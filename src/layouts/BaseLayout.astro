---
import '../styles/global.css';
import { SITE, CLOUDFLARE_TOKEN } from '../data/site.js';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';

const { titulo, descripcion, imagen, tipo = 'website' } = Astro.props;
const tituloFinal = titulo ? `${titulo} · ${SITE.nombre}` : `${SITE.nombre} · ${SITE.lema}`;
const desc = descripcion || SITE.descripcion;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// URL canónica absoluta de la página (para compartir)
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// Convierte una ruta de imagen en URL absoluta (la que exigen WhatsApp/Facebook)
function absolutizar(img) {
  if (!img) return null;
  if (/^https?:\/\//i.test(img)) return img;
  const rel = img.startsWith('/') ? img : `${base}/${img}`;
  return Astro.site ? new URL(rel, Astro.site).href : rel;
}
// Imagen para compartir: la del artículo, o el logo por defecto.
const ogImagen = absolutizar(imagen) || absolutizar(`${base}/imagenes/logo.jpg`);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloFinal}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <!-- Open Graph (WhatsApp, Facebook, Telegram) -->
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloFinal} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImagen} />

    {CLOUDFLARE_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${CLOUDFLARE_TOKEN}"}`}></script>
    )}
  </head>
  <body>
    <Cabecera />
    <main>
      <slot />
    </main>
    <Pie />
  </body>
</html>
