---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TarjetaEntrada from '../../../components/TarjetaEntrada.astro';
import { entradasDeSeccion, tematicasDeSeccion, aSlug } from '../../../data/contenido.js';

export async function getStaticPaths() {
  const tematicas = await tematicasDeSeccion('articulos');
  const entradas = await entradasDeSeccion('articulos');
  return tematicas.map((t) => ({
    params: { tema: t.slug },
    props: {
      nombre: t.nombre,
      entradas: entradas.filter((e) => aSlug(e.data.categoria) === t.slug),
    },
  }));
}

const { nombre, entradas } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (ruta) => `${base}${ruta}`;
---
<BaseLayout titulo={`${nombre} · Artículos`}>
  <div class="contenedor seccion">
    <div class="encabezado-pagina">
      <p class="migas">
        <a href={u('/')}>Inicio</a> ·
        <a href={u('/articulos')}>Artículos</a>
      </p>
      <span class="chip">Temática</span>
      <h1 style="margin-top:0.4rem">{nombre}</h1>
      <p class="subtitulo">{entradas.length} {entradas.length === 1 ? 'entrada' : 'entradas'} en esta temática.</p>
    </div>
    <div class="lista-entradas">
      {entradas.map((e) => <TarjetaEntrada entrada={e} />)}
    </div>
  </div>
</BaseLayout>
