---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout titulo="¡Gracias por suscribirte!">
  <div class="contenedor seccion" style="text-align:center;padding:4.5rem 1rem;max-width:34rem">
    <img src={`${base}/imagenes/logo.jpg`} alt="Senda Reformada" style="width:96px;height:96px;border-radius:50%;margin-bottom:1.2rem" />
    <h1 style="margin-top:0">¡Gracias por suscribirte!</h1>
    <p class="subtitulo">Revisa tu correo: la primera vez te llegará un mensaje para confirmar tu suscripción.</p>
    <p style="margin-top:1.6rem">
      <a class="boton boton-primario" href={`${base}/`}>Volver al inicio</a>
    </p>
  </div>
</BaseLayout>
