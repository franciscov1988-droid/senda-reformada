---
import TarjetaEntrada from './TarjetaEntrada.astro';
import { SECCIONES } from '../data/site.js';
import { entradasDeSeccion, tematicasDeSeccion } from '../data/contenido.js';

// Vista de una sección completa: lista las entradas agrupadas por temática.
const { seccionId } = Astro.props;
const seccion = SECCIONES.find((s) => s.id === seccionId);
const entradas = await entradasDeSeccion(seccionId);
const tematicas = await tematicasDeSeccion(seccionId);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (ruta) => `${base}${ruta}`;

// Agrupa las entradas por temática, respetando el orden alfabético de temáticas.
const grupos = tematicas.map((t) => ({
  ...t,
  entradas: entradas.filter((e) => e.data.categoria === t.nombre),
}));
---
<div class="contenedor seccion">
  <div class="encabezado-pagina">
    <h1 style="margin-top:0">{seccion.nombre}</h1>
    <p class="subtitulo">{seccion.descripcion}</p>
  </div>

  {grupos.length > 0 ? (
    grupos.map((g) => (
      <section class="grupo-tematica">
        <div class="titulo-tematica">
          <h2>{g.nombre}</h2>
          <a href={u(`/${seccionId}/tema/${g.slug}`)}>Ver temática →</a>
        </div>
        <div class="lista-entradas">
          {g.entradas.map((e) => <TarjetaEntrada entrada={e} />)}
        </div>
      </section>
    ))
  ) : (
    <p class="vacio">Aún no hay entradas en esta sección.</p>
  )}
</div>
