---
import { SITE, REDES } from '../data/site.js';
import IconoRed from './IconoRed.astro';

const anio = new Date().getFullYear();
const rango = anio > SITE.anioInicio ? `${SITE.anioInicio}–${anio}` : `${anio}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (ruta) => `${base}${ruta}`;
---
<footer class="pie">
  <div class="pie-inner">
    <img class="pie-logo" src={u('/imagenes/logo.jpg')} alt={`Logo de ${SITE.nombre}`} />
    <div class="pie-nombre">{SITE.nombre}</div>
    <p class="lema-pie">{SITE.lema}</p>

    <div class="redes">
      {REDES.map((r) => (
        <a class="red-enlace" href={r.url} title={r.nombre} target="_blank" rel="noopener noreferrer">
          <IconoRed nombre={r.icono} />
        </a>
      ))}
    </div>

    <nav class="pie-nav">
      <a href={u('/')}>Inicio</a>
      <a href={u('/devocionales')}>Devocionales</a>
      <a href={u('/articulos')}>Artículos</a>
      <a href={u('/archivo')}>Archivo</a>
      <a href={u('/acerca')}>Acerca de</a>
    </nav>

    <p class="pie-legal">© {rango} {SITE.nombre}. «Soli Deo Gloria».</p>
  </div>
</footer>
