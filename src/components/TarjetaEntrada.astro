---
import { formatearFecha, aSlug } from '../data/contenido.js';
import { SECCIONES } from '../data/site.js';

// Muestra una entrada como tarjeta. Si mostrarSeccion=true, indica
// de qué sección proviene (útil en el Archivo que mezcla todo).
const { entrada, mostrarSeccion = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (ruta) => `${base}${ruta}`;

const seccionNombre =
  SECCIONES.find((s) => s.id === entrada.seccion)?.nombre || entrada.seccion;
const temaSlug = aSlug(entrada.data.categoria);
---
<article class="tarjeta">
  <div class="meta">
    <a class="chip" href={u(`/${entrada.seccion}/tema/${temaSlug}`)}>{entrada.data.categoria}</a>
    {mostrarSeccion && <span class="seccion-etiqueta">{seccionNombre}</span>}
    <span class="fecha">{formatearFecha(entrada.data.pubDate)}</span>
  </div>
  <h3><a href={u(entrada.url)}>{entrada.data.title}</a></h3>
  {entrada.data.description && <p class="resumen">{entrada.data.description}</p>}
</article>
