---
import { formatearFecha, aSlug, rutaImagen } from '../data/contenido.js';
import { SECCIONES, SITE } from '../data/site.js';

const { entrada, mostrarSeccion = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (ruta) => `${base}${ruta}`;

const seccionNombre = SECCIONES.find((s) => s.id === entrada.seccion)?.nombre || entrada.seccion;
const temaSlug = aSlug(entrada.data.categoria);
const portada = rutaImagen(entrada.data.imagen);
const autor = entrada.data.author || SITE.autor;
---
<article class="tarjeta">
  {portada && (
    <a href={u(entrada.url)} class="tarjeta-imagen">
      <img src={portada} alt={entrada.data.imagenAlt || entrada.data.title} loading="lazy" />
    </a>
  )}
  <div class="tarjeta-cuerpo">
    <div class="meta">
      <a class="chip" href={u(`/${entrada.seccion}/tema/${temaSlug}`)}>{entrada.data.categoria}</a>
      {mostrarSeccion && <span class="seccion-etiqueta">{seccionNombre}</span>}
    </div>
    <h3><a href={u(entrada.url)}>{entrada.data.title}</a></h3>
    {entrada.data.description && <p class="resumen">{entrada.data.description}</p>}
    <div class="firma"><strong>{autor}</strong> · {formatearFecha(entrada.data.pubDate)}</div>
  </div>
</article>
